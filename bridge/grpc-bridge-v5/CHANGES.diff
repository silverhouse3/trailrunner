+func setBridgeRun(started bool, belt float64, sp *fakeSpeed) {
+	mu.Lock()
+	bridgeStarted = started
+	currentSpeed = belt
+	workoutState = "RUNNING"
+	mu.Unlock()
+	sp.mu.Lock()
+	sp.belt = belt
+	sp.mu.Unlock()
+}
