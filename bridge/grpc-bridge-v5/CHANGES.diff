+func TestDeadmanCreepStopFailureRetriesMax5(t *testing.T) {
+	_, wk, t0 := tripCreeping(t)
+	wk.mu.Lock()
+	wk.stopErr = fmt.Errorf("boom")
+	wk.mu.Unlock()
+	for d := time.Second; d <= 40*time.Second; d += 500 * time.Millisecond {
+		deadmanEvaluate(t0.Add(d))
+	}
