+		lastSpeedSetTime = time.Now().Add(-time.Second)
+		mu.Unlock()
+		safeSpeedSet(22)
+		got := sp.snapshot()[i]
+		if got < want-0.05 || got > want+0.05 {
+			t.Fatalf("step %d: got %.2f want %.1f", i, got, want)
+		}
+		want += 4
+	}
+}
